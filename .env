# Database Configuration
# IMPORTANT: Replace this with your actual Neon connection string
# Get it from your Neon dashboard by clicking "Connect"
DATABASE_URL=postgresql://your_username:your_password@your_host/your_database?sslmode=require

# Development Configuration
NODE_ENV=development
PORT=3000

# Instructions:
# 1. Go to your Neon dashboard (https://console.neon.tech/)
# 2. Click "Connect" on your pineapplevision-db project
# 3. Copy the connection string
# 4. Replace the DATABASE_URL above with your actual connection string
# 5. Run: npm run db:push
# 6. Run: npm run dev